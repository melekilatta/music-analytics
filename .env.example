# PostgreSQL (docker-compose подставляет те же PG_USER/PG_PASSWORD/PG_DB)
PG_HOST=localhost
PG_PORT=15432
PG_USER=music_user
PG_PASSWORD=change_me
PG_DB=music_analytics

# Spotify Client Credentials API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Сбор Deezer
MAX_TRACKED_TRACKS=20
CHART_LIMIT=20
DEEZER_GENRE_IDS=0
TRACK_RETENTION_DAYS=60
REQUEST_DELAY_SEC=0.25
MAX_RETRY_AFTER_SEC=120
MAX_CONSECUTIVE_FAILURES=10
ISRC_RECHECK_DAYS=14

# Контрольная группа новых релизов Spotify
ENABLE_RELEASES=true
RELEASE_DISCOVERY_DAYS=14
RELEASE_TRACK_DAYS=28
MAX_TRACKED_RELEASES=150
